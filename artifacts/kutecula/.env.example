# ─────────────────────────────────────────────────────────────
# Kutecula Visuals — Variáveis de Ambiente
# Copiar para .env.local para desenvolvimento local
# Configurar no painel do Vercel para produção
# ─────────────────────────────────────────────────────────────

# Resend — Envio de emails do formulário de contacto
# Criar conta em https://resend.com e verificar o domínio kutecula.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin — Password para aceder à página /admin
# Escolhe uma password segura
ADMIN_PASSWORD=alterar-esta-password

# Vercel KV — Armazenamento do portfólio (opcional)
# Configurar em https://vercel.com/dashboard → Storage → KV
# Se não configurado, o portfólio usa os dados estáticos do código
KV_REST_API_URL=https://xxxxxxxx.kv.vercel-storage.com
KV_REST_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
